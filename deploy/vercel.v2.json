{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "bun install --frozen-lockfile",
  "buildCommand": "bun run build:showcase",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    { "source": "/(how|how\\.html)", "destination": "/built", "permanent": false },
    { "source": "/harbour\\.html", "destination": "/harbour", "permanent": false },
    { "source": "/demos\\.html", "destination": "/demos", "permanent": false },
    {
      "source": "/",
      "has": [{ "type": "query", "key": "repo", "value": "(?<repo>[^/]+/[^/]+)" }],
      "destination": "/hall/:repo",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(demos|harbour|built|hall|studio|pieces|palette|composer|npcs|grips|town)",
      "destination": "/index.html"
    },
    {
      "source": "/(hall|pieces|composer|npcs|grips|town)/(.+)",
      "destination": "/index.html"
    },
    {
      "source": "/lab/(hexworld|hexmap|hexscale|hextiles|hud|replay|site)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://img.shields.io; connect-src 'self' data: blob: https://cdn.jsdelivr.net; media-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/library/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/library/(.*)\\.glb",
      "headers": [{ "key": "Content-Type", "value": "model/gltf-binary" }]
    },
    {
      "source": "/data/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/(home|site|lab)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    },
    {
      "source": "/lab/(.*)\\.gz",
      "headers": [{ "key": "Content-Type", "value": "application/gzip" }]
    },
    {
      "source": "/(og\\.jpg|favicon\\.svg|robots\\.txt|sitemap\\.xml)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    }
  ]
}
