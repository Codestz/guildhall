{
  "name": "opencode-guildhall",
  "version": "0.1.0",
  "description": "Nine guild agents for OpenCode, and a live 3D hall where you watch them work.",
  "type": "module",
  "license": "MIT",
  "author": "Codestz",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "agents",
    "subagents",
    "multi-agent",
    "visualizer",
    "three",
    "guildhall"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Codestz/guildhall.git",
    "directory": "packages/opencode-guildhall"
  },
  "main": "./dist/server.js",
  "exports": {
    ".": "./dist/server.js",
    "./server": "./dist/server.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "opencode-guildhall": "dist/cli.js"
  },
  "files": [
    "dist",
    "server.js"
  ],
  "engines": {
    "node": ">=20",
    "bun": ">=1.3"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "prepack": "bun scripts/build.ts"
  },
  "devDependencies": {
    "@guildhall/herald": "workspace:*",
    "@guildhall/hub": "workspace:*",
    "@guildhall/roster": "workspace:*"
  },
  "homepage": "https://guildhall.codestz.dev",
  "bugs": {
    "url": "https://github.com/Codestz/guildhall/issues"
  }
}
